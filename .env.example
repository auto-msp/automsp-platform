# ── AutoMSP platform environment ──────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit real values.

# Public site URL (SEO, canonical, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (PostgreSQL; Supabase Postgres recommended).
# When set, the app persists via Prisma; when unset it uses the local
# .data/store/ JSON adapter. Never point the app at a database whose URL
# you do not control, and never commit a real URL.
# DATABASE_URL=postgresql://user:password@localhost:5432/automsp

# Credential vault: base64-encoded 32 bytes. Without it the app uses a
# development key file (.data/vault.key, gitignored) — fine locally, never in
# production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTOMSP_VAULT_KEY=

# Scheduler switch. The automation scheduler is an in-process poller and must
# run in exactly one server instance. Default (unset) = enabled, which is
# correct for single-instance deployments. On multi-instance deployments set
# AUTOMSP_SCHEDULER=off on every instance except one. /api/health reports
# which state this instance is in.
# AUTOMSP_SCHEDULER=off

# Authentication (local credential auth is built in; SSO via Clerk/Supabase/Auth.js is a later slice)
AUTH_SECRET=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# AI providers. Server-side only, never exposed to the client. Set exactly the
# key whose provider you use; all model calls (workflow AI steps, agent
# playground, evaluation runs, embeddings) route through src/server/ai/provider.ts.
# When none is set, agent definitions stay editable but every AI surface
# reports "provider not configured" — no output is ever simulated.
# Blank lines below are the contract; never commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: pin the provider when multiple keys exist (default: first configured)
# AUTOMSP_AI_PROVIDER=anthropic | openai | google

# Payments (Stripe — Phase 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Transactional email (Resend or equivalent)
RESEND_API_KEY=
EMAIL_FROM=AutoMSP <hello@automsp.us>

# Storage (S3-compatible or Supabase Storage)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Integration OAuth secrets (added as integrations ship)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
