// AutoMSP — multi-tenant control plane for managed AI automation.
// Multi-tenancy rule: every tenant-owned resource carries organizationId.
// Enforce at the database layer (RLS in production), never only in the UI.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity & tenancy ─────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  // autosp | customer
  kind      String   @default("customer")
  industry  String?
  size      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members       OrganizationMember[]
  projects      Project[]
  clients       Client[]
  opportunities Opportunity[]
  audits        Audit[]
  systems       System[]
  automations   Automation[]
  agents        Agent[]
  knowledge     KnowledgeSource[]
  connections   IntegrationConnection[]
  executions    Execution[]
  approvals     Approval[]
  incidents     Incident[]
  metrics       MetricRecord[]
  reports       Report[]
  notifications Notification[]
  subscriptions Subscription[]
  invoices      Invoice[]
  usageRecords  UsageRecord[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]
  aiRuns        AiRun[]
  agentRuns     AgentRun[]
  evalSuites    EvalSuite[]
  evalRuns      EvalRun[]

  @@map("organizations")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  // local credential auth (scrypt hash); absent on SSO-fed accounts later
  passwordHash String? @map("password_hash")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships OrganizationMember[]
  sessions    Session[]

  @@map("users")
}

// Opaque session tokens — only the sha256 hash is ever stored.
model Session {
  id        String   @id
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Brute-force throttle state, keyed by sign-in email.
model AuthAttempt {
  email       String    @id
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until")

  @@map("auth_attempts")
}

// Marketing-site audit funnel inbox (pre-auth submissions; no organization yet).
model AuditRequest {
  id             String   @id
  company        String
  name           String
  email          String
  phone          String?
  role           String?
  companySize    String?  @map("company_size")
  industry       String?
  currentSystems String?  @map("current_systems")
  bottlenecks    String?
  aiUsage        String?  @map("ai_usage")
  processVolume  String?  @map("process_volume")
  outcomes       String?
  // received | in_review | scheduled | completed | declined
  status         String   @default("received")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("audit_requests")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  // platform_owner | automsp_admin | automsp_operator | automsp_analyst |
  // customer_owner | customer_admin | customer_member | customer_viewer
  role           String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Team {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("teams")
}

// ───────────────────────────── Delivery & commercial ──────────────────────────

model Client {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  industry       String?
  size           String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@index([organizationId])
  @@map("clients")
}

model Project {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  clientId       String?  @map("client_id")
  name           String
  // lead | discovery | audit | proposal | approved | design | build | testing |
  // deployment | managed_operations | expansion
  stage          String   @default("lead")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id])

  @@index([organizationId, stage])
  @@map("projects")
}

model Opportunity {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  company        String
  contactName    String?  @map("contact_name")
  contactEmail   String?  @map("contact_email")
  source         String?
  industry       String?
  size           String?
  estimatedValue Decimal? @map("estimated_value") @db.Decimal(14, 2)
  // new | qualified | discovery | audit | proposal | negotiation | won | lost
  stage          String   @default("new")
  probability    Int?
  expectedClose  DateTime? @map("expected_close")
  owner          String?
  notes          String?
  nextAction     String?  @map("next_action")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, stage])
  @@map("opportunities")
}

model Audit {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  company        String
  contactName    String   @map("contact_name")
  contactEmail   String   @map("contact_email")
  phone          String?
  role           String?
  companySize    String?  @map("company_size")
  industry       String?
  aiUsage        String?  @map("ai_usage")
  currentSystems String?  @map("current_systems")
  bottlenecks    String?
  processVolume  String?  @map("process_volume")
  desiredOutcomes String? @map("desired_outcomes")
  // received | in_review | scheduled | completed | declined
  status         String   @default("received")
  // identified opportunities, scored: businessImpact × frequency × feasibility × strategicFit
  findings       Json?
  priorityScore  Decimal? @map("priority_score") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("audits")
}

model Service {
  id          String   @id @default(uuid())
  category    String
  name        String
  description String?
  outcomes    Json?
  pricing     Json?    // set via admin; never hard-coded in UI
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("services")
}

// ───────────────────────────── Systems, automations, agents ───────────────────

model System {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  // healthy | warning | paused | incident | draft
  status         String   @default("draft")
  businessOutcome String? @map("business_outcome")
  ownerId        String?  @map("owner_id")
  // denormalized display name used by the current app surface
  ownerName      String?  @map("owner_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automations  Automation[]
  agents       Agent[]

  @@index([organizationId, status])
  @@map("systems")
}

model Automation {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  systemId       String?  @map("system_id")
  name           String
  description    String?
  // draft | active | paused | archived
  status         String    @default("draft")
  // user-supplied estimate of human minutes avoided per completed run
  estMinutesPerRun Int     @default(0) @map("est_minutes_per_run")
  // scheduler cursor: next due time when the trigger is a schedule
  nextRunAt      DateTime? @map("next_run_at")
  lastScheduledAt DateTime? @map("last_scheduled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by")
  updatedBy      String?   @map("updated_by")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  system       System?       @relation(fields: [systemId], references: [id])
  versions     AutomationVersion[]
  executions   Execution[]

  @@index([organizationId, status])
  @@map("automations")
}

model AutomationVersion {
  id           String   @id @default(uuid())
  automationId String   @map("automation_id")
  version      Int
  // v1 stores the whole validated graph here ({nodes, edges}); the
  // WorkflowNode/WorkflowEdge tables remain the future normalized form.
  definition   Json?
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by")

  automation Automation     @relation(fields: [automationId], references: [id], onDelete: Cascade)
  nodes      WorkflowNode[]
  edges      WorkflowEdge[]

  @@unique([automationId, version])
  @@map("automation_versions")
}

model WorkflowNode {
  id           String   @id @default(uuid())
  versionId    String   @map("version_id")
  key          String
  // trigger | condition | branch | filter | loop | delay | classify | summarize |
  // extract | generate | reason | agent | integration | approval | output
  type         String
  config       Json
  positionX    Float?   @map("position_x")
  positionY    Float?   @map("position_y")

  version      AutomationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  outEdges     WorkflowEdge[]    @relation("from")
  inEdges      WorkflowEdge[]    @relation("to")

  @@unique([versionId, key])
  @@map("workflow_nodes")
}

model WorkflowEdge {
  id         String  @id @default(uuid())
  versionId  String  @map("version_id")
  fromNodeId String  @map("from_node_id")
  toNodeId   String  @map("to_node_id")
  condition  Json?

  version   AutomationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  fromNode  WorkflowNode      @relation("from", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode    WorkflowNode      @relation("to", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@map("workflow_edges")
}

model Agent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  systemId       String?  @map("system_id")
  name           String
  purpose        String?
  description    String?
  // draft | testing | approved | production | paused | archived
  status         String   @default("draft")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  system       System?       @relation(fields: [systemId], references: [id])
  versions     AgentVersion[]
  aiRuns       AiRun[]
  agentRuns    AgentRun[]
  evalSuites   EvalSuite[]

  @@index([organizationId, status])
  @@map("agents")
}

model AgentVersion {
  id                 String   @id @default(uuid())
  agentId            String   @map("agent_id")
  version            Int
  model              String
  systemInstructions String   @map("system_instructions")
  // permission scopes granted to this version, e.g. ["read_crm","send_email"]
  permissionScopes   String[] @map("permission_scopes")
  approvalPolicy     Json     @map("approval_policy")
  limits             Json     // token, cost, timeout, retry budgets
  createdAt          DateTime @default(now()) @map("created_at")
  createdBy          String?  @map("created_by")

  agent Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tools AgentTool[]
  runs  AgentRun[]

  @@unique([agentId, version])
  @@map("agent_versions")
}

model AgentTool {
  id             String  @id @default(uuid())
  agentVersionId String  @map("agent_version_id")
  key            String
  description    String?
  requiredScope  String  @map("required_scope")
  config         Json?

  agentVersion AgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)

  @@map("agent_tools")
}

// ───────────────────────────── Knowledge / RAG ────────────────────────────────

model KnowledgeSource {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  // upload | web | integration
  kind           String
  permissions    Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    Document[]

  @@index([organizationId])
  @@map("knowledge_sources")
}

model Document {
  id          String   @id @default(uuid())
  sourceId    String   @map("source_id")
  filename    String
  mimeType    String   @map("mime_type")
  storageKey  String   @map("storage_key")
  version     Int      @default(1)
  // pending | parsing | chunking | embedding | indexed | failed
  status      String   @default("pending")
  chunkCount  Int      @default(0) @map("chunk_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]

  @@index([sourceId, status])
  @@map("documents")
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  ordinal    Int
  content    String
  // embedding stored via pgvector in production; column added in migration
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@map("document_chunks")
}

// ───────────────────────────── Integrations ───────────────────────────────────

model Integration {
  id       String  @id @default(uuid())
  key      String  @unique  // google | microsoft | slack | hubspot | salesforce | ...
  name     String
  category String
  // available | coming_soon — never claim function before it exists
  availability String @default("coming_soon")
  scopes   Json?

  connections IntegrationConnection[]

  @@map("integrations")
}

model IntegrationConnection {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  // optional: set when the row is linked to a catalog Integration entry
  integrationId  String?    @map("integration_id")
  // catalog key (slack | hubspot | ... | generic-http), denormalized so vault
  // records do not require seeded catalog rows
  providerKey    String?    @map("provider_key")
  name           String     @default("")
  // api_token | header_secret | oauth2 (oauth2 = later slice)
  authType       String?    @map("auth_type")
  // active | revoked | expired | error | disconnected
  status         String     @default("active")
  scopes         String[]
  // reference to secret in the vault — secrets never in this table, never to client
  credentialRef  String?    @map("credential_ref")
  // AES-256-GCM sealed secret (base64 iv|tag|ciphertext) — see src/server/vault.ts
  sealedSecret   String?    @map("sealed_secret")
  // last 4 chars of the secret, for operator recognition only
  secretPreview  String?    @map("secret_preview")
  lastUsedAt     DateTime?  @map("last_used_at")
  createdBy      String?    @map("created_by")
  lastSyncAt     DateTime?  @map("last_sync_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration? @relation(fields: [integrationId], references: [id])

  @@index([organizationId, status])
  @@map("integration_connections")
}

// ───────────────────────────── Execution engine ───────────────────────────────

model Execution {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  automationId   String?   @map("automation_id")
  workflowKey    String?   @map("workflow_key")
  // queued | running | waiting | completed | failed | cancelled | timed_out
  status         String    @default("queued")
  // denormalized label for list views (automation may later be renamed)
  automationName String?   @map("automation_name")
  // automation version this run executed
  version        Int?
  // trigger kind: "manual" | "schedule" (JSON for forward compatibility)
  trigger        Json?
  input          Json?
  output         Json?
  error          Json?
  // engine cursor when paused at an approval node
  resume         Json?
  // idempotency: same key + same org → same result, no duplicate processing
  idempotencyKey String?   @map("idempotency_key")
  costCents      Int?      @map("cost_cents")
  tokensUsed     Int?      @map("tokens_used")
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automation   Automation?     @relation(fields: [automationId], references: [id])
  steps        ExecutionStep[]
  logs         ExecutionLog[]
  approvals    Approval[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@map("executions")
}

model ExecutionStep {
  id          String    @id @default(uuid())
  executionId String    @map("execution_id")
  nodeKey     String    @map("node_key")
  status      String    @default("pending")
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("execution_steps")
}

model ExecutionLog {
  id          String   @id @default(uuid())
  executionId String   @map("execution_id")
  level       String   @default("info") // info | warn | error
  message     String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
  @@map("execution_logs")
}

model Approval {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  // workflow | agent_tool
  kind           String    @default("workflow")
  executionId    String?   @map("execution_id")
  agentRunId     String?   @map("agent_run_id")
  action         String
  rationale      String?
  payload        Json?
  riskLevel      String    @default("medium") @map("risk_level") // low | medium | high
  // pending | approved | rejected | changes_requested | escalated
  status         String    @default("pending")
  reviewerId     String?   @map("reviewer_id")
  decidedAt      DateTime? @map("decided_at")
  decisionNote   String?   @map("decision_note")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  execution   Execution?    @relation(fields: [executionId], references: [id])
  agentRun    AgentRun?     @relation(fields: [agentRunId], references: [id])

  @@index([organizationId, status])
  @@map("approvals")
}

model Incident {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  title          String
  severity       String    @default("medium") // low | medium | high | critical
  // open | investigating | mitigated | resolved
  status         String    @default("open")
  rootCause      String?   @map("root_cause")
  startedAt      DateTime  @default(now()) @map("started_at")
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("incidents")
}

// ───────────────────────────── Metrics, reports, notifications ────────────────

model MetricRecord {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String   // hours_saved | executions | success_rate | cost | ...
  value          Decimal  @db.Decimal(18, 4)
  // actual | estimated | projected — never blur these
  basis          String   @default("actual")
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  calculation    Json?    // source + method, per ROI transparency rules
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, key, periodStart])
  @@map("metrics")
}

model Report {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  // weekly_ops | monthly_impact | system_health | automation_performance | ai_cost | incident
  type           String
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  payload        Json
  storageKey     String?  @map("storage_key")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type, createdAt])
  @@map("reports")
}

model Notification {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  kind           String   // workflow_failure | approval | incident | integration | report | billing | project
  title          String
  body           String?
  href           String?
  readAt         DateTime? @map("read_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@map("notifications")
}

// ───────────────────────────── Billing ────────────────────────────────────────

model Subscription {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  stripeCustomerId   String?   @map("stripe_customer_id")
  stripeSubscriptionId String? @map("stripe_subscription_id")
  planKey            String    @map("plan_key")
  // trialing | active | past_due | cancelled
  status             String    @default("trialing")
  currency           String    @default("usd") // inr supported via Stripe
  currentPeriodEnd   DateTime? @map("current_period_end")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, planKey])
  @@map("subscriptions")
}

model Invoice {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  stripeInvoiceId String?  @map("stripe_invoice_id")
  // draft | open | paid | void | uncollectible
  status         String
  currency       String    @default("usd")
  amountDueCents Int       @map("amount_due_cents")
  amountPaidCents Int      @default(0) @map("amount_paid_cents")
  dueAt          DateTime? @map("due_at")
  paidAt         DateTime? @map("paid_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("invoices")
}

model UsageRecord {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  // executions | tokens | agent_runs | storage_mb
  meter          String
  quantity       Decimal  @db.Decimal(18, 4)
  unitCostCents  Int?     @map("unit_cost_cents")
  recordedAt     DateTime @default(now()) @map("recorded_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, meter, recordedAt])
  @@map("usage_records")
}

// ───────────────────────── AI runs, evaluations ─────────────────────────

model AiRun {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  agentId          String?  @map("agent_id")
  executionId      String?  @map("execution_id")
  evalRunId        String?  @map("eval_run_id")
  agentRunId       String?  @map("agent_run_id")
  // playground | workflow | evaluation | agent
  source           String
  provider         String
  model            String
  // completed | failed
  status           String   @default("completed")
  inputPreview     String?  @map("input_preview")
  outputPreview    String?  @map("output_preview")
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  // list-price estimate; null when the model has no catalog price
  costEstimatedUsd Decimal? @db.Decimal(10, 6) @map("cost_estimated_usd")
  latencyMs        Int      @default(0) @map("latency_ms")
  // semantic | lexical — which retrieval method actually served
  retrievalMethod  String?  @map("retrieval_method")
  retrievalChunks  Int?     @map("retrieval_chunks")
  error            String?
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentRun     AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("ai_runs")
}

model AgentRun {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  agentId          String   @map("agent_id")
  agentVersionId   String   @map("agent_version_id")
  // running | waiting_approval | completed | failed | rejected
  status           String   @default("running")
  // transcript (user/assistant/tool), invocation outcomes, pending calls
  messages         Json
  invocations      Json
  pendingToolCalls Json     @map("pending_tool_calls")
  finalText        String?  @map("final_text")
  error            String?
  turns            Int      @default(0)
  maxTurns         Int      @default(6) @map("max_turns")
  // playground
  source           String   @default("playground")
  createdBy        String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent         Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion  AgentVersion  @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  approvals     Approval[]
  aiRuns        AiRun[]

  @@index([organizationId, createdAt])
  @@map("agent_runs")
}

model EvalSuite {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  agentId        String?  @map("agent_id")
  name           String
  description    String   @default("")
  // exact | contains | llm_judge
  scorer         String   @default("exact")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  cases        EvalCase[]
  runs         EvalRun[]

  @@index([organizationId])
  @@map("eval_suites")
}

model EvalCase {
  id        String   @id @default(uuid())
  suiteId   String   @map("suite_id")
  input     String
  expected  String
  createdAt DateTime @default(now()) @map("created_at")

  suite EvalSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)

  @@index([suiteId])
  @@map("eval_cases")
}

model EvalRun {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  suiteId        String    @map("suite_id")
  agentId        String?   @map("agent_id")
  model          String?
  scorerUsed     String?   @map("scorer_used")
  // completed | failed | blocked
  status         String    @default("completed")
  total          Int       @default(0)
  passed         Int       @default(0)
  failed         Int       @default(0)
  blockedReason  String?   @map("blocked_reason")
  startedAt      DateTime  @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdBy      String?   @map("created_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  suite        EvalSuite    @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  results      EvalResult[]

  @@index([organizationId, startedAt])
  @@map("eval_runs")
}

model EvalResult {
  id        String   @id @default(uuid())
  runId     String   @map("run_id")
  caseId    String   @map("case_id")
  output    String?
  passed    Boolean?
  reason    String?
  latencyMs Int?     @map("latency_ms")
  createdAt DateTime @default(now()) @map("created_at")

  run EvalRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("eval_results")
}

// ───────────────────────────── Audit log & API platform ───────────────────────

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  actorId        String?  @map("actor_id")
  action         String   // login | permission_change | workflow_change | approval | ...
  resource       String?
  resourceId     String?  @map("resource_id")
  // free-form context bag used by the app (never contains secrets)
  metadata       Json?
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  hashedKey      String    @map("hashed_key")
  scopes         String[]
  rateLimit      Int?      @map("rate_limit")
  expiresAt      DateTime? @map("expires_at")
  lastUsedAt     DateTime? @map("last_used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

// ───────────────────────────── Shared rate limiting ──────────────────────────
// Global (not tenant-scoped): keys are endpoint + client address. Exists so
// the limiter survives multiple instances; the in-memory limiter remains the
// fallback when DATABASE_URL is unset.

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("rate_limit_buckets")
}
